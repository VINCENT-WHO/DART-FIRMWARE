set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(DEFINED ENV{ARM_GCC_BIN})
    file(TO_CMAKE_PATH "$ENV{ARM_GCC_BIN}" DART_TOOLCHAIN_BIN)
else()
    get_filename_component(DART_TOOLCHAIN_BIN "${CMAKE_CURRENT_LIST_DIR}/../../work/toolchain/bin" ABSOLUTE)
endif()
find_program(DART_ARM_GCC arm-none-eabi-gcc HINTS "${DART_TOOLCHAIN_BIN}" REQUIRED)
get_filename_component(DART_TOOLCHAIN_BIN "${DART_ARM_GCC}" DIRECTORY)
set(CMAKE_C_COMPILER "${DART_ARM_GCC}")
set(CMAKE_ASM_COMPILER "${DART_ARM_GCC}")
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${DART_TOOLCHAIN_BIN}" REQUIRED)
find_program(DART_ARM_SIZE arm-none-eabi-size HINTS "${DART_TOOLCHAIN_BIN}" REQUIRED)
